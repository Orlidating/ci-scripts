{
  "name": "@orlidating/ci-scripts",
  "version": "1.0.0",
  "description": "Repo-agnostic CI checks: GitHub Action SHA pinning against a reviewed lockfile, and multi-tool staged-file formatting",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orlidating/ci-scripts.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "check-action-pins": "bin/check-action-pins.mjs",
    "format-staged": "bin/format-staged.mjs"
  },
  "files": [
    "bin",
    "action-pins.lock.json"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "github-actions",
    "supply-chain",
    "sha-pinning",
    "formatting",
    "pre-commit"
  ],
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "prettier": "3.9.6",
    "sql-formatter": "15.8.2"
  }
}
